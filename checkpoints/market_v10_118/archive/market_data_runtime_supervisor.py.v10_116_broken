from market.runtime_supervisor_metrics import (
    RuntimeSupervisorMetrics
)


class MarketDataRuntimeSupervisor:
    """
    Production runtime supervisor.

    Responsibilities:
        - Control runtime lifecycle
        - Monitor runtime health
        - Persist health snapshots
        - Persist supervisor events
        - Track recovery metrics
        - Execute controlled recovery

    Does NOT contain:
        - Exchange communication
        - Market data logic
        - Trading decisions
        - Scheduler logic
        - Storage implementation
    """

    def __init__(
        self,
        runtime,
        health_repository=None,
        event_repository=None,
        metrics_repository=None
    ):
        self._runtime = runtime

        self._health_repository = (
            health_repository
        )

        self._event_repository = (
            event_repository
        )

        self._metrics_repository = (
            metrics_repository
        )

        # V10.116 Architecture Alignment: Using the new core metrics object
        self._metrics = RuntimeSupervisorMetrics(
            repository=metrics_repository
        )


    # --- Backward Compatibility Methods (V10.104/V10.109 Contracts) ---

    def metrics(self) -> dict:
        """
        Backward compatibility metrics access.
        """
        return self._metrics.snapshot()


    @property
    def running(self) -> bool:
        """
        Backward compatibility runtime state.
        """
        return getattr(
            self._runtime,
            "running",
            False
        )


    def health(self) -> dict:
        """
        Backward compatibility health access.
        """
        return self.check_health()


    # --- Lifecycle Management & Metric Increments ---

    def start(self) -> None:
        """
        Start supervised runtime.
        """

        self._runtime.start()

        self._metrics.increment(
            "starts"
        )

        self.check_health()


    def stop(self) -> None:
        """
        Stop supervised runtime.
        """

        self._runtime.stop()

        self._metrics.increment(
            "stops"
        )

        self.check_health()


    def restart(self) -> dict:
        """
        Controlled runtime restart.
        """

        result = (
            self._runtime.restart()
        )

        self._metrics.increment(
            "restarts"
        )

        self.check_health()

        return result


    def check_health(self) -> dict:
        """
        Read and persist runtime health.
        """

        health = (
            self._runtime.health()
        )

        if self._health_repository:

            self._health_repository.save_health(
                health
            )

        return health


    def _record_event(
        self,
        event: str
    ) -> None:
        """
        Persist supervisor event.
        """

        if self._event_repository:

            self._event_repository.save_event(
                event
            )


    def recover(self) -> dict:
        """
        Controlled recovery policy.
        """

        self._record_event(
            "recovery_started"
        )

        health = (
            self.check_health()
        )

        if health["healthy"]:

            return {
                "recovered": False,
                "reason": "runtime_healthy"
            }


        try:

            result = (
                self._runtime.restart()
            )

            # Post-restart health check to verify success
            post_health = self.check_health()

            if post_health["healthy"]:
                self._metrics.increment(
                    "recoveries"
                )
                self._record_event(
                    "recovery_success"
                )
                return {
                    "recovered": True,
                    "result": result
                }
            else:
                self._metrics.increment(
                    "recovery_failures"
                )
                self._record_event(
                    "recovery_failed"
                )
                return {
                    "recovered": False,
                    "reason": "recovery_failed_health_check"
                }

        except Exception as e:
            self._metrics.increment(
                "recovery_failures"
            )
            self._record_event(
                "recovery_error"
            )
            raise e
